[Unit]
Description=wsl-egress: event-driven kill-switch and sing-box supervisor
After=wsl-egress-firewall.service wsl-egress-identity.service
Wants=wsl-egress-firewall.service

[Service]
Type=simple
ExecStart=/usr/local/bin/wsl-egress daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
