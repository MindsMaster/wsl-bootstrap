[Unit]
Description=wslb-agent: nftables allowlist and blackhole default route before any network use
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target wslb-guard.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/wslb-agent firewall-up

[Install]
WantedBy=sysinit.target
