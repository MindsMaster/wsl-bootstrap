[Unit]
Description=wslb-agent: event-driven kill-switch and sing-box supervisor
After=wslb-firewall.service wslb-identity.service
Wants=wslb-firewall.service

[Service]
Type=simple
ExecStart=/usr/local/bin/wslb-agent guard
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
